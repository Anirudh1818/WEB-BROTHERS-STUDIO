# ----------------------------------------------------------------------------
# Web Brothers Digital — environment variables
# Copy this file to ".env.local" and fill in the values you have.
# The site works without these; they just unlock email delivery + correct SEO URL.
# ----------------------------------------------------------------------------

# Email delivery for the contact form (recommended).
# 1) Create a free account at https://resend.com
# 2) Create an API key and paste it below.
# Until this is set, leads are still captured (server logs) and WhatsApp works.
RESEND_API_KEY=

# The "From" address for lead emails.
# Use Resend's shared test sender until you verify your own domain in Resend.
LEAD_FROM_EMAIL="Web Brothers Digital <onboarding@resend.dev>"

# Your live website URL (used for SEO, sitemap & social previews) once deployed.
NEXT_PUBLIC_SITE_URL=https://www.webbrothersdigital.in
